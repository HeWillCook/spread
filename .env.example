# Postgres connection string. When unset, the app uses an embedded PGlite
# database in .data/pglite (fine for local development). REQUIRED in production:
# the app refuses to start on PGlite there.
# Pooled strings work (Neon pooled, Supabase transaction pooler on port 6543); the app
# turns prepared statements off. Run `npm run db:migrate` against a direct/session
# connection (Supabase port 5432) if the pooler gives you trouble.
# DATABASE_URL=postgres://user:password@localhost:5432/spread

# Direct (non-pooled) connection used only by `npm run db:migrate`; falls back to
# DATABASE_URL. `neon deploy` / `neon env pull` write both into .env.local.
# DATABASE_URL_UNPOOLED=postgres://user:password@host/spread

# Connections held per server instance, a whole number from 1 to 10. Defaults to 1 in
# production and on Vercel (one per serverless instance) and 5 in development.
# DATABASE_POOL_MAX=1

# Folder for the embedded PGlite database when DATABASE_URL is unset (default
# .data/pglite). Setting it explicitly also allows PGlite in production, which the
# end-to-end tests use for a throwaway database.
# PGLITE_DATA_DIR=.data/pglite

# Better Auth (host login). Required in production; any random string works,
# e.g. `openssl rand -base64 32`. In development a built-in fallback is used.
BETTER_AUTH_SECRET=

# Public origin of the app, used for auth callbacks and cookies.
# Example: http://localhost:3000 locally, https://your-domain.com in production.
BETTER_AUTH_URL=http://localhost:3000
