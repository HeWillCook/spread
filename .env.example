# Postgres connection string. When unset, the app uses an embedded PGlite
# database in .data/pglite (fine for local development).
# DATABASE_URL=postgres://user:password@localhost:5432/cookout

# Better Auth (host login). Required in production; any random string works,
# e.g. `openssl rand -base64 32`. In development a built-in fallback is used.
BETTER_AUTH_SECRET=

# Public origin of the app, used for auth callbacks and cookies.
# Example: http://localhost:3000 locally, https://your-domain.com in production.
BETTER_AUTH_URL=http://localhost:3000
